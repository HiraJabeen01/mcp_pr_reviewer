# OpenAI Platform credentials (separate from a ChatGPT subscription)
OPENAI_API_KEY="<your_openai_platform_api_key>"
OPENAI_MODEL="gpt-5.6"
OPENAI_TIMEOUT_SECONDS="180"

# Remote MCP registry already registered with ChatGPT.
# OpenAI's API must also be able to reach this public HTTPS endpoint.
TOOL_REGISTRY_URL="https://your-mcp-host.example.com/mcp"
MCP_AUTHORIZATION=""

# Workflow destinations and webhook authentication
SLACK_CHANNEL_ID="C01234567"
GITHUB_WEBHOOK_SECRET="<use_a_long_random_secret>"

# Durable duplicate-delivery tracking and retry behavior
WEBHOOK_DELIVERY_DB="webhook_deliveries.sqlite3"
WEBHOOK_MAX_ATTEMPTS="3"
WEBHOOK_RETRY_BASE_SECONDS="2"
WEBHOOK_PROCESSING_STALE_SECONDS="900"
